NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Thème : bouton lune/soleil sur le dashboard. Mettre "false" pour masquer le contrôle (défaut : affiché).
# NEXT_PUBLIC_ENABLE_DARK_MODE="false"

# AI assistant (/api/chat). Au moins une clé côté serveur (.env.local) :
# Groq (gratuit, rapide) — utilisé en priorité par défaut : https://console.groq.com/keys
GROQ_API_KEY="gsk_YOUR_GROQ_API_KEY"
# GROQ_CHAT_MODEL="llama-3.3-70b-versatile"

# OpenAI (optionnel, repli si Groq indisponible ou si CHAT_PROVIDER=openai) :
# https://platform.openai.com/api-keys
# OPENAI_API_KEY="sk-YOUR_OPENAI_API_KEY"
# OPENAI_CHAT_MODEL="gpt-4o-mini"

# CHAT_PROVIDER=groq → Groq d’abord, puis OpenAI si les deux clés sont présentes.
# CHAT_PROVIDER=openai → uniquement OpenAI (pas de Groq).
# Sans variable : même comportement que groq (Groq en priorité).
CHAT_PROVIDER="groq"

# =============================================================================
# Qonto — API Business (synchronisation des transactions, bouton du dashboard)
# =============================================================================
# Documentation : https://docs.qonto.com/get-started/business-api/authentication/api-key
# Dans Qonto : Intégrations et partenariats → Clé API → identifiant (login) + clé secrète.
#
# QONTO_LOGIN="votre-identifiant-organisation"
# QONTO_SECRET_KEY="votre-cle-secrete"
#
# Compte à lire (sinon : compte principal EUR, sinon premier compte actif) :
# QONTO_BANK_ACCOUNT_ID="uuid-du-compte"
# ou
# QONTO_IBAN="FR7616958000010000000000000"
#
# Sandbox : https://thirdparty-sandbox.staging.qonto.co
# QONTO_API_BASE_URL="https://thirdparty-sandbox.staging.qonto.co"
# QONTO_STAGING_TOKEN="si requis par Qonto pour le bac à sable"
#
# Périmètre des lignes importées (colonne scope) : pro (défaut) ou personal
# QONTO_IMPORT_SCOPE="pro"

# =============================================================================
# Powens — Revolut personnel (Budget Insight / webview connect)
# =============================================================================
# Console Powens : crée une app, puis renseigne domaine + client_id/secret + redirect.
# Dans la webview, connecte uniquement ton compte Revolut personnel.
#
# POWENS_DOMAIN="votre-sous-domaine.biapi.pro"
# POWENS_CLIENT_ID="…"
# POWENS_CLIENT_SECRET="…"
# POWENS_REDIRECT_URI="https://votre-domaine.vercel.app/api/powens/callback"
