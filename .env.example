NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Thème : bouton lune/soleil sur le dashboard. Mettre "false" pour masquer le contrôle (défaut : affiché).
# NEXT_PUBLIC_ENABLE_DARK_MODE="false"

# =============================================================================
# Qonto — API Business (synchronisation des transactions, bouton du dashboard)
# =============================================================================
# Documentation : https://docs.qonto.com/get-started/business-api/authentication/api-key
# Dans Qonto : Intégrations et partenariats → Clé API → identifiant (login) + clé secrète.
#
# QONTO_LOGIN="votre-identifiant-organisation"
# QONTO_SECRET_KEY="votre-cle-secrete"
#
# Compte à lire (sinon : compte principal EUR, sinon premier compte actif) :
# QONTO_BANK_ACCOUNT_ID="uuid-du-compte"
# ou
# QONTO_IBAN="FR7616958000010000000000000"
#
# Sandbox : https://thirdparty-sandbox.staging.qonto.co
# QONTO_API_BASE_URL="https://thirdparty-sandbox.staging.qonto.co"
# QONTO_STAGING_TOKEN="si requis par Qonto pour le bac à sable"
#
# Périmètre des lignes importées (colonne scope) : pro (défaut) ou personal
# QONTO_IMPORT_SCOPE="pro"

# =============================================================================
# Powens — API cloud (création utilisateur + synchro transactions)
# =============================================================================
# Connexion bancaire : le dashboard ouvre la webview officielle
# https://webview.powens.com/connect après GET /2.0/auth/token/code (sans SDK npm).
# Déclarez l’URL de callback ci-dessous telle quelle dans la console Powens (domaine, port, http/https et slash final doivent correspondre au caractère près ; éviter localhost vs 127.0.0.1 mélangés) :
# POWENS_REDIRECT_URI="http://localhost:3000/api/powens/callback"
#
# Optionnel : forcer la langue de la webview (segment d’URL /fr/connect, etc.)
# POWENS_WEBVIEW_LANG="fr"
# Par défaut la webview s’ouvre en redirection pleine page (recommandé PSD2 / Revolut). Pour un nouvel onglet :
# NEXT_PUBLIC_POWENS_WEBVIEW_NEW_TAB="true"
# Optionnel : si la webview échoue, repli script Powens Connect :
# NEXT_PUBLIC_POWENS_CONNECT_SCRIPT_URL="https://…/powens-connect.js"
#
# API Powens / Budget Insight — ne pas utiliser api.powens.com si votre DNS ne le résout pas (ENOTFOUND).
# Recommandé sandbox : racine du domaine BI uniquement (sans /2.0 — le serveur l’ajoute pour les appels API).
# POWENS_DOMAIN="https://votre-client-sandbox.biapi.pro"
#
# Optionnel : URL complète si votre contrat impose un chemin différent (sinon laisser vide et utiliser DOMAIN).
# POWENS_API_BASE_URL="https://api.powens.com/v2"
# Budget Insight (recommandé) — crée l’utilisateur via POST /2.0/auth/init :
# POWENS_CLIENT_ID="…"
# POWENS_CLIENT_SECRET="…"
# Les GET avec jeton utilisateur peuvent aussi recevoir automatiquement ?client_id=… si POWENS_CLIENT_ID est défini (exigence de certaines instances BI).
#
# Ancien flux optionnel (Bearer plateforme + POST /users) si votre contrat l’exige :
# POWENS_PLATFORM_BEARER_TOKEN="…"
#
# Libellé de la colonne company sur les lignes importées (défaut : Powens) :
# POWENS_COMPANY_LABEL="Powens"
#
# Périmètre scope des imports Powens : personal (défaut si absent) | pro (SASU uniquement si défini explicitement)
# POWENS_IMPORT_SCOPE="pro"
#
# Double flux SASU + perso sur le même utilisateur Powens :
# POWENS_SYNC_PERSONAL="true"
# (alternative : définir POWENS_PERSONAL_COMPANY_LABEL pour activer le second bouton)
# Séparer les comptes avec des listes d’ids Powens (`id_account`) :
# POWENS_PRO_ACCOUNT_IDS="12345, 67890"
# POWENS_PERSONAL_ACCOUNT_IDS="11111"
#
# Libellé company pour le second import perso (défaut : Powens perso) :
# POWENS_PERSONAL_COMPANY_LABEL="Powens perso"
#

# =============================================================================
# Gmail — Factures DigitPro émises par Hiway (bloc « Factures émises » de l'Activité)
# =============================================================================
# OAuth Google (lecture seule Gmail). Le dashboard ouvre l'écran de consentement
# Google après clic sur « Connecter Gmail », puis recherche les emails de
# noreply@hiway.fr dont le sujet commence par « DigitPro Consulting - Facture F ».
#
# Procédure (console Google Cloud — https://console.cloud.google.com/) :
#   1. Créez un projet (ou réutilisez-en un).
#   2. « APIs & Services » → « Library » → activez « Gmail API ».
#   3. « APIs & Services » → « OAuth consent screen » : type « External »,
#      ajoutez votre adresse Gmail dans « Test users », scope .../auth/gmail.readonly.
#   4. « APIs & Services » → « Credentials » → « Create credentials » →
#      « OAuth client ID » → type « Web application ».
#   5. « Authorized redirect URIs » : ajoutez EXACTEMENT l'URL ci-dessous
#      (domaine, port, http/https et chemin doivent correspondre au caractère près).
#   6. Copiez le Client ID + Client secret ci-dessous.
#
# GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxx"
# Local :
# GOOGLE_REDIRECT_URI="http://localhost:3000/api/gmail/callback"
# Production (Vercel) — même Client ID/secret, URI différente + ajout dans Google Cloud :
# GOOGLE_REDIRECT_URI="https://digitpro-monitoring-md1k.vercel.app/api/gmail/callback"
#
